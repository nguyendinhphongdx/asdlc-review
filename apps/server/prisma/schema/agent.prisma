// Chủ sở hữu: modules/agent. Chỉ lưu ID chuỗi của MR/repo (không relation chéo module).
model AgentMessage {
  id        String   @id @default(cuid())
  mrId      String
  role      String // user | agent | system
  text      String
  steps     String? // JSON: các bước agent đã làm (suy luận, gọi tool)
  createdAt DateTime @default(now())

  @@index([mrId, createdAt])
}

model AgentLesson {
  id        String   @id @default(cuid())
  repoId    String
  text      String
  status    String // proposed | active | rejected
  source    String // user | agent | feedback
  mrId      String?
  createdAt DateTime @default(now())

  @@index([repoId, status])
}

/// Đề xuất của agent chờ người duyệt: đăng comment lên MR hoặc chạy lại review.
model AgentAction {
  id        String   @id @default(cuid())
  mrId      String
  kind      String // comment | rerun
  payload   String // JSON: { file?, line?, body?, reason? }
  status    String // pending | done | dismissed
  createdAt DateTime @default(now())

  @@index([mrId, status])
}
