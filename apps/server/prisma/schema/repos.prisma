// Chủ sở hữu: modules/repos.
model Repository {
  id            String    @id @default(cuid())
  platform      String
  fullPath      String
  webUrl        String
  defaultBranch String?
  frameworkId   String?
  provider      String? // provider AI riêng cho repo (null = mặc định)
  enabled       Boolean   @default(true)
  autoReview    Boolean   @default(true)
  skipDrafts      Boolean?  // null = theo cài đặt chung
  targetBranches  String?   // danh sách nhánh đích (phân tách dấu phẩy, hỗ trợ *): chỉ tự review MR nhắm vào các nhánh này; null = mọi nhánh
  publishComments Boolean?  // null = theo framework
  diffBudgetChars Int?      // null = theo cài đặt chung
  lastPolledAt  DateTime?
  createdAt     DateTime  @default(now())

  @@unique([platform, fullPath])
}

/// Nhật ký sự kiện webhook nhận được (để hiển thị trạng thái webhook). Giữ tối đa 50 dòng mỗi repo.
model WebhookEvent {
  id        String   @id @default(cuid())
  repoKey   String // `${platform}/${fullPath}`: có thể chưa có Repository (sự kiện bị từ chối trước khi đăng ký)
  at        DateTime @default(now())
  event     String
  result    String // accepted | rejected | ignored | skipped
  detail    String?

  @@index([repoKey, at])
}
