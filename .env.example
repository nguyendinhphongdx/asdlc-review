# --- Server ---
PORT=4319
PUBLIC_URL=http://localhost:4319
DATA_DIR=./data
DATABASE_URL=file:../../../data/mrd.db
REDIS_URL=redis://127.0.0.1:6379
REVIEW_CONCURRENCY=2

# --- GitLab ---
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=            # PAT scope: api, read_repository
GITLAB_WEBHOOK_SECRET=   # trùng với "Secret token" khi tạo webhook
BOT_MENTION=@mr-reviewer # comment "/review" hoặc "@mr-reviewer review" để trigger

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# --- AI provider: claude-cli | codex-cli | openai-compatible ---
REVIEW_PROVIDER=claude-cli
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_BUDGET_USD=3
CODEX_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Publish ---
PUBLISH_COMMENTS=true    # false = chỉ chấm điểm, không comment lên MR
INLINE_MIN_SEVERITY=major
MAX_INLINE_COMMENTS=15
POLL_INTERVAL_MIN=0      # >0 để bật poller (cho desktop không nhận được webhook)
