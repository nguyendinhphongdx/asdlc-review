# --- Server ---
PORT=4319
PUBLIC_URL=http://localhost:4319
DATA_DIR=./data
DATABASE_URL=file:../../../data/mrd.db
# Mặc định "sqlite": hàng đợi lưu trong SQLite, không cần Redis/Docker. Chỉ đặt redis://127.0.0.1:6379 nếu chạy nhiều server.
REDIS_URL=sqlite
REVIEW_CONCURRENCY=2

# --- GitLab ---
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=            # tuỳ chọn: có thể nhập trên UI (Cài đặt → Kết nối), UI được ưu tiên
GITLAB_WEBHOOK_SECRET=   # tuỳ chọn: UI tự sinh secret nếu để trống
MRD_SECRET_KEY=          # khoá mã hoá token trong DB (>=16 ký tự); trống = tự tạo data/secret.key
BOT_MENTION=@mr-reviewer # comment "/review" hoặc "@mr-reviewer review" để trigger

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# --- AI provider: claude-cli | codex-cli | gemini-api | openai-compatible ---
REVIEW_PROVIDER=claude-cli
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_BUDGET_USD=0
CODEX_MODEL=
# Gemini API (Google cloud): có thể nhập khoá ở Cài đặt → Review thay vì đặt ở đây
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Publish ---
# Đăng comment lên MR do FRAMEWORK quyết định (mục `publish`, mặc định tắt), không cấu hình ở đây.
INLINE_MIN_SEVERITY=major
MAX_INLINE_COMMENTS=15
POLL_INTERVAL_MIN=0      # >0 để bật poller (cho desktop không nhận được webhook)
